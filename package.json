{
  "name": "wallet-hygiene",
  "version": "0.1.0",
  "description": "Keep your own wallets under control: find leaked keys, find forgotten addresses with leftover funds, and sweep them to your main wallet.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wallet-hygiene": "bin/wallet-hygiene.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "wallet", "ethereum", "base", "security", "hygiene", "sweep", "keys", "crypto"
  ],
  "files": ["bin", "src", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "echo 'No build step required for wallet-hygiene'",
    "lint": "node --check bin/wallet-hygiene.js && node --check src/index.js"
  },
  "dependencies": {
    "viem": "^2.57.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rustemmustafingovua-byte/wallet-hygiene.git"
  },
  "bugs": {
    "url": "https://github.com/rustemmustafingovua-byte/wallet-hygiene/issues"
