{
  "name": "wallet-hygiene",
  "version": "0.2.0",
  "description": "Keep your own wallets under control. Find leaked keys and forgotten balances on your machine, sweep them to your main wallet, and sell public balance lookups via x402. Private keys never leave the machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wallet-hygiene": "bin/wallet-hygiene.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "wallet", "ethereum", "base", "security", "hygiene", "sweep", "keys", "crypto", "x402"
  ],
  "files": ["bin", "src", "README.md", "LICENSE", "docs/SECURITY.md"],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "build": "echo 'No build step required for wallet-hygiene'",
    "lint": "node scripts/lint.js",
    "start": "node bin/wallet-hygiene.js serve",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "viem": "^2.57.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rustemmustafingovua-byte/wallet-hygiene.git"
  },
  "bugs": {
    "url": "https://github.com/rustemmustafingovua-byte/wallet-hygiene/issues"
  },
  "homepage": "https://github.com/rustemmustafingovua-byte/wallet-hygiene",
  "funding": {
    "custom": [
      "https://github.com/sponsors/rustemmustafingovua-byte"
    ]
  }
}