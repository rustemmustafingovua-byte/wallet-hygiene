# Copy to .env and fill in. Never commit .env. The API does not read private keys.
# Do not set WALLET_HYGIENE_KEYS on the public API host.

# --- local CLI (sweep) ---
# WALLET_HYGIENE_CONFIG_DIR=$HOME/.config/wallet-hygiene
# WALLET_HYGIENE_MAIN=0xYourMainWallet
# WALLET_HYGIENE_KEYFILE=$HOME/.config/wallet-hygiene/keys.json
# WALLET_HYGIENE_ROOTS=/path/one,/path/two
# WALLET_HYGIENE_RPC_BASE=https://mainnet.base.org
# WALLET_HYGIENE_RPC_ETH=https://ethereum-rpc.publicnode.com
# WALLET_HYGIENE_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# WALLET_HYGIENE_RPC_OPTIMISM=https://mainnet.optimism.io
# WALLET_HYGIENE_RPC_POLYGON=https://polygon-rpc.com

# --- paid API (x402). Leave X402_ENABLED unset until X402_PAY_TO is yours. ---
HOST=127.0.0.1
PORT=8787
X402_ENABLED=false
X402_PAY_TO=
X402_NETWORK=eip155:8453
X402_PRICE_ATOMIC=10000
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_AUTH=
X402_FREE_QUOTA=10
X402_TIMEOUT_SECONDS=60
X402_MAX_ADDRESSES=20
